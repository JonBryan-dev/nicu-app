# --- Vercel / Next.js ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Server-side only (never exposed to the browser) ---
# Blood-gas photo reading (/api/extract) and the Companion chat (/api/companion).
# Without it both fall back gracefully — photo scan is disabled, chat goes offline.
ANTHROPIC_API_KEY=
# Optional. Raises the PubMed rate limit from 3 to 10 requests/second for the
# Lungs tab (/api/evidence) and scripts/refresh-evidence.mjs. Works fine without.
NCBI_API_KEY=

# --- Supabase edge function secrets (set via `supabase secrets set`) ---
# SUPABASE_URL=            (provided automatically in hosted functions)
# SUPABASE_SERVICE_ROLE_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Generate VAPID keys once:  npx web-push generate-vapid-keys
